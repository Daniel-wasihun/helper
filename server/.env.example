# Server Configuration
PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:3000
SESSION_SECRET=super_secret_session_key_change_me_in_production

# Better Auth Configuration
BETTER_AUTH_SECRET=your_better_auth_secret_min_32_characters
BETTER_AUTH_URL=http://localhost:3001

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/Helper?schema=public"

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Email Provider (SendGrid or Mailgun)
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=your_sendgrid_api_key
MAILGUN_API_KEY=your_mailgun_api_key
MAILGUN_DOMAIN=your_mailgun_domain
SUPPORT_EMAIL=support@yourdomain.com
