datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

enum UserRole {
  ADMIN
  AGENT
}

enum TicketStatus {
  OPEN
  RESOLVED
  CLOSED
}

enum TicketCategory {
  GENERAL_QUESTION
  TECHNICAL_QUESTION
  REFUND_REQUEST
}

enum SenderType {
  CUSTOMER
  AGENT
  SYSTEM
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String
  name         String
  role         UserRole      @default(AGENT)
  isActive     Boolean       @default(true)
  tickets      Ticket[]      @relation("AssignedTickets")
  messages     Message[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Ticket {
  id            String         @id @default(uuid())
  ticketNumber  Int            @unique @default(autoincrement())
  subject       String
  status        TicketStatus   @default(OPEN)
  category      TicketCategory @default(GENERAL_QUESTION)
  customerEmail String
  customerName  String?
  aiSummary     String?        @db.Text
  assignedToId  String?
  assignedTo    User?          @relation("AssignedTickets", fields: [assignedToId], references: [id])
  messages      Message[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Message {
  id               String      @id @default(uuid())
  ticketId         String
  ticket           Ticket      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderType       SenderType  @default(CUSTOMER)
  senderEmail      String
  senderId         String?
  sender           User?       @relation(fields: [senderId], references: [id])
  bodyText         String      @db.Text
  bodyHtml         String?     @db.Text
  aiSuggestedReply String?     @db.Text
  createdAt        DateTime    @default(now())
}

model KnowledgeArticle {
  id         String             @id @default(uuid())
  title      String
  content    String             @db.Text
  category   TicketCategory     @default(GENERAL_QUESTION)
  embeddings ArticleEmbedding[]
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
}

model ArticleEmbedding {
  id        String           @id @default(uuid())
  articleId String
  article   KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  chunkText String           @db.Text
  // Note: pgvector raw SQL is used for vector(768) distance search
  createdAt DateTime         @default(now())
}
