{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node", "@playwright/test"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "playwright.config.ts",
    "e2e/**/*",
    "scripts/**/*"
  ],
  "exclude": [
    "node_modules",
    "client",
    "server"
  ]
}
